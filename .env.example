# ─────────────────────────────────────────────────────────────────────────────
# Karvaahh web app — environment variables
# Copy to `.env.local` (never commit real values) and fill in what you use.
# Variables starting with NEXT_PUBLIC_ are visible in the browser — no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site origin, no trailing slash (used by a few structured-data files).
NEXT_PUBLIC_SITE_URL=https://karvaahh.in

# ── Main contact form (/contact) — REQUIRED in production ────────────────────
# Configure at least one delivery method, otherwise enquiries fail in production.
# Option A: webhook (Zapier, Make, n8n, CRM…) receiving the enquiry as JSON.
CONTACT_WEBHOOK_URL=
# Option B: e-mail through Resend (https://resend.com). All three are needed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Other enquiry forms ──────────────────────────────────────────────────────
# Educational tours form → POST /activities/api/educational-inquiry
INQUIRY_WEBHOOK_URL=
# Amarnath & Vaishno Devi enquiry (server action)
ENQUIRY_WEBHOOK_URL=
# Client-side form endpoints (optional — forms fall back to WhatsApp / contact page)
NEXT_PUBLIC_INQUIRY_ENDPOINT=
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
NEXT_PUBLIC_CORPORATE_INQUIRY_ENDPOINT=
NEXT_PUBLIC_SKYDIVE_NOTIFY_ENDPOINT=

# ── Contact channels used by enquiry buttons ─────────────────────────────────
# WhatsApp number, digits only with country code (the site's published Nepal number is 9779766861547).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Packages hub ─────────────────────────────────────────────────────────────
# "true" shows draft (unfinished) packages — keep unset in production.
NEXT_PUBLIC_SHOW_DRAFT_PACKAGES=
